<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>Quick Fix - Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; font-family: 'Prompt', sans-serif !important; }
        body { background-color: #e9f0e8; margin: 0; padding: 0; color: #222; }

        .navbar { background-color: #2b2b2b; padding: 0 40px; display: flex; justify-content: space-between; align-items: center; height: 65px; }
        .navbar .brand { font-size: 26px; font-weight: 700; color: #fff; text-decoration: none; }
        .navbar .brand span { color: #f4c430; }
        .navbar .nav-menu { display: flex; height: 100%; align-items: center; gap: 10px; }
        .navbar .nav-link { color: #fff; text-decoration: none; padding: 0 18px; height: 100%; display: flex; align-items: center; font-size: 15px; font-weight: 500; transition: 0.2s; position: relative; }
        .navbar .nav-link:hover, .navbar .nav-link.active { color: #f4c430; }
        .navbar .nav-link.active::after { content: ''; position: absolute; bottom: 0; left: 0; width: 100%; height: 4px; background-color: #f4c430; border-radius: 4px 4px 0 0; }
        .navbar .btn-logout { color: #ff6b6b !important; }

        .container { max-width: 1100px; margin: 30px auto; padding: 0 20px; }
        .dashboard-section-title { font-size: 22px; font-weight: 700; margin-bottom: 15px; color: #111; }

        /* การ์ดสรุปภาพรวมตามรูปที่ 1 */
        .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 20px; }
        .stat-card { background: #fff1c5; padding: 18px; border-radius: 12px; text-align: center; }
        .stat-card .label { font-size: 14px; font-weight: 600; color: #333; margin-bottom: 6px; }
        .stat-card .number { font-size: 32px; font-weight: 700; color: #111; }

        /* การ์ดแสดงรายได้รวม / ค่าใช้จ่าย / รายได้สุทธิ */
        .revenue-card { background: #fff1c5; padding: 20px; border-radius: 12px; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; text-align: center; margin-bottom: 30px; }
        .revenue-item { border-right: 2px solid #dcdcd0; padding: 0 10px; }
        .revenue-item:last-child { border-right: none; }
        .revenue-item .val { font-size: 34px; font-weight: 700; }
        .revenue-item .unit { font-size: 13px; color: #555; }

        /* ตารางคิดเงินหน้าเคาน์เตอร์ */
        .table-card { background: #fff; border-radius: 12px; padding: 25px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #eee; font-size: 14px; }
        th { background-color: #2f2f2f; color: #f4c430; }

        .btn-pay { background-color: #28a745; color: white; border: none; padding: 6px 14px; border-radius: 20px; font-weight: 600; cursor: pointer; }
        .btn-paid { background-color: #e2e3e5; color: #6c757d; border: none; padding: 6px 14px; border-radius: 20px; font-weight: 600; }

        /* Modal คิดเงิน */
        .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; }
        .modal-content { background: #fff; padding: 30px; border-radius: 16px; width: 90%; max-width: 450px; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; font-weight: 600; margin-bottom: 5px; font-size: 13px; }
        .form-group input { width: 100%; padding: 10px; border-radius: 8px; border: 1px solid #ccc; font-size: 15px; }
        .btn-submit { background: #28a745; color: white; border: none; width: 100%; padding: 12px; border-radius: 8px; font-weight: 700; font-size: 15px; cursor: pointer; margin-top: 10px; }
    </style>
</head>
<body>

    <nav class="navbar">
        <a href="/admin/dashboard" class="brand"><span>Quick</span> Fix</a>
        <div class="nav-menu">
            <a href="/admin/dashboard" class="nav-link active">หน้าแรก</a>
            <a href="/admin/manage" class="nav-link">จัดการคิว/สถานะ</a>
            <a href="#" class="nav-link" onclick="alert('กำลังพัฒนา'); return false;">การตั้งค่าบริการ</a>
            <a href="/logout" class="nav-link btn-logout">ออกจากระบบ</a>
        </div>
    </nav>

    <div class="container">
        <div class="dashboard-section-title">ภาพรวมวันนี้</div>
        
        <!-- การ์ดคิว -->
        <div class="stats-grid">
            <div class="stat-card"><div class="label">คิวทั้งหมด</div><div class="number"><%= stats.total %></div></div>
            <div class="stat-card"><div class="label">รอเข้ารับบริการ</div><div class="number"><%= stats.pending %></div></div>
            <div class="stat-card"><div class="label">กำลังดำเนินการ</div><div class="number"><%= stats.inProgress %></div></div>
            <div class="stat-card"><div class="label">เสร็จสิ้น</div><div class="number"><%= stats.completed %></div></div>
        </div>

        <!-- การ์ดรายได้สรุปตามรูปที่ 1 -->
        <div class="revenue-card">
            <div class="revenue-item">
                <div class="label" style="font-weight:600;">รายได้รวม</div>
                <div class="val" style="color: #28a745;"><%= stats.totalRevenue.toLocaleString() %> <span class="unit">บาท</span></div>
            </div>
            <div class="revenue-item">
                <div class="label" style="font-weight:600;">ค่าใช้จ่าย/อุปกรณ์</div>
                <div class="val" style="color: #dc3545;"><%= stats.totalExpense.toLocaleString() %> <span class="unit">บาท</span></div>
            </div>
            <div class="revenue-item">
                <div class="label" style="font-weight:600;">รายได้สุทธิ</div>
                <div class="val" style="color: #007bff;"><%= stats.totalNetIncome.toLocaleString() %> <span class="unit">บาท</span></div>
            </div>
        </div>

        <!-- ตารางคิดเงินเคาน์เตอร์ -->
        <div class="table-card">
            <div class="dashboard-section-title" style="font-size: 18px;">ชำระเงินบริการเคาน์เตอร์</div>
            <table>
                <thead>
                    <tr>
                        <th>รหัสคิว</th>
                        <th>ลูกค้า / รถยนต์</th>
                        <th>บริการ</th>
                        <th>สถานะการชำระ</th>
                        <th>การคิดเงิน</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (bookings && bookings.length > 0) { %>
                        <% bookings.forEach(b => { %>
                            <tr>
                                <td><strong><%= b.booking_code %></strong></td>
                                <td><%= b.customer_name %><br><small style="color:#666;"><%= b.license_plate %></small></td>
                                <td><%= b.service_program %></td>
                                <td>
                                    <% if (b.payment_status === 'paid') { %>
                                        <span style="color:#28a745; font-weight:600;">✓ ชำระแล้ว</span>
                                    <% } else { %>
                                        <span style="color:#dc3545; font-weight:600;">⏳ รอชำระ</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (b.payment_status === 'paid') { %>
                                        <button class="btn-paid" disabled>ชำระแล้ว (<%= Number(b.net_income).toLocaleString() %> ฿)</button>
                                    <% } else { %>
                                        <button class="btn-pay" onclick="openPayModal('<%= b.id %>', '<%= b.booking_code %>', '<%= b.service_program %>')">💵 ชำระเงิน</button>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr><td colspan="5" style="text-align:center;">ไม่มีข้อมูลคิว</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal คำนวณคิดเงิน -->
    <div id="payModal" class="modal">
        <div class="modal-content">
            <h3 style="margin-top:0;">💳 ชำระเงินบริการ <span id="modal-code"></span></h3>
            <p style="color:#666; font-size:14px;" id="modal-service"></p>
            <form action="/admin/process-payment" method="POST">
                <input type="hidden" name="booking_id" id="modal-booking-id">
                <div class="form-group">
                    <label>ราคาบริการ (บาท):</label>
                    <input type="number" step="0.01" name="total_price" id="total_price" value="500" oninput="calcNet()" required>
                </div>
                <div class="form-group">
                    <label>หัก ค่าใช้จ่าย/ต้นทุนอุปกรณ์ (บาท):</label>
                    <input type="number" step="0.01" name="expense" id="expense" value="150" oninput="calcNet()" required>
                </div>
                <div class="form-group" style="background: #f8f9fa; padding: 10px; border-radius: 8px;">
                    <label>รายได้สุทธิที่จะได้รับ:</label>
                    <div style="font-size: 22px; font-weight: 700; color: #28a745;" id="net_label">350.00 บาท</div>
                </div>
                <button type="submit" class="btn-submit">ยืนยันการชำระเงิน</button>
                <button type="button" onclick="closePayModal()" style="width:100%; border:none; background:none; margin-top:8px; cursor:pointer; color:#777;">ยกเลิก</button>
            </form>
        </div>
    </div>

    <script>
        function openPayModal(id, code, service) {
            document.getElementById('modal-booking-id').value = id;
            document.getElementById('modal-code').innerText = code;
            document.getElementById('modal-service').innerText = 'บริการ: ' + service;
            
            // สมมติราคาตามประเภทบริการเบื้องต้น
            let defaultPrice = 300;
            let defaultExpense = 100;
            if (service.includes('ขัด') || service.includes('เคลือบ')) { defaultPrice = 500; defaultExpense = 150; }
            if (service.includes('ซ่อม') || service.includes('น้ำมันเครื่อง')) { defaultPrice = 1500; defaultExpense = 800; }

            document.getElementById('total_price').value = defaultPrice;
            document.getElementById('expense').value = defaultExpense;
            calcNet();
            
            document.getElementById('payModal').style.display = 'flex';
        }

        function closePayModal() { document.getElementById('payModal').style.display = 'none'; }

        function calcNet() {
            const p = parseFloat(document.getElementById('total_price').value) || 0;
            const e = parseFloat(document.getElementById('expense').value) || 0;
            document.getElementById('net_label').innerText = (p - e).toFixed(2) + ' บาท';
        }
    </script>
</body>
</html>