<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ประวัติการดำเนินการ - Quick Fix</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Prompt', sans-serif; background-color: #f2f7f2; margin: 0; padding: 0; color: #222; }
        .container { max-width: 900px; margin: 30px auto; background: #fff; padding: 35px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .page-header { display: flex; align-items: center; gap: 10px; margin-bottom: 25px; }
        .btn-back { font-size: 20px; text-decoration: none; color: #222; border: 1px solid #ccc; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; }

        .history-card { background-color: #fff3c4; padding: 16px 20px; border-radius: 12px; margin-bottom: 15px; display: flex; justify-content: space-between; align-items: center; }
        .history-info { display: flex; align-items: center; gap: 15px; }
        .dot-icon { width: 14px; height: 14px; background-color: #888; border-radius: 50%; flex-shrink: 0; }
        .time-text { font-size: 12px; color: #666; margin-bottom: 2px; }
        .title-text { font-weight: 600; font-size: 15px; color: #111; margin: 0; }
        .desc-text { font-size: 13px; color: #555; margin-top: 2px; }

        .btn-check { background-color: #ffcc00; color: #222; border: none; padding: 8px 22px; border-radius: 20px; font-family: 'Prompt'; font-weight: 600; font-size: 13px; cursor: pointer; transition: 0.2s; }
        .btn-check:hover { background-color: #e6b800; }
        
        .history-detail { display: none; background-color: #fff8d6; padding: 20px; border-radius: 10px; margin-top: -10px; margin-bottom: 15px; border-top: 1px dashed #ccc; }
        .history-detail h5 { margin: 0 0 10px 0; font-size: 15px; color: #222; }
        .history-detail p { margin: 4px 0; font-size: 13px; color: #444; }
        .empty-state { text-align: center; padding: 50px 20px; color: #777; font-size: 16px; }
    </style>
</head>
<body>

    <!-- ดึง Navbar สารบัญกลางมาแสดงผล -->
    <%- include('../partials/navbar-user') %>

    <div class="container">
        <div class="page-header">
            <a href="/user" class="btn-back">←</a>
            <h2 style="margin: 0; font-size: 22px;">ประวัติการดำเนินการ</h2>
        </div>

        <% if (bookings && bookings.length > 0) { %>
            <% bookings.forEach((b, index) => { %>
                <div class="history-card">
                    <div class="history-info">
                        <div class="dot-icon"></div>
                        <div>
                            <div class="time-text">
                                <%= b.booking_date ? new Date(b.booking_date).toLocaleDateString('th-TH') : '-' %> | <%= b.time_slot %> น.
                            </div>
                            <h4 class="title-text">
                                <% if (b.status === 'completed') { %>
                                    แจ้งเตือนการให้บริการเสร็จสิ้น (<%= b.booking_code %>)
                                <% } else if (b.status === 'in-progress') { %>
                                    แจ้งเตือนกำลังดำเนินการบริการ (<%= b.booking_code %>)
                                <% } else { %>
                                    แจ้งเตือนบันทึกการนัดหมายสำเร็จ (<%= b.booking_code %>)
                                <% } %>
                            </h4>
                            <div class="desc-text">
                                การให้บริการ <%= b.service_program %> | ทะเบียน <%= b.license_plate %>
                            </div>
                        </div>
                    </div>
                    <button class="btn-check" onclick="toggleHistoryDetail(<%= index %>)">ตรวจสอบ</button>
                </div>

                <div id="history-detail-<%= index %>" class="history-detail">
                    <h5>รายละเอียดการรับบริการ :</h5>
                    <p><strong>การให้บริการ :</strong> <%= b.service_program %></p>
                    <p><strong>รถยนต์ :</strong> <%= b.car_brand || '-' %> <%= b.car_model || '' %> / ทะเบียน <%= b.license_plate %> (<%= b.province || 'ชลบุรี' %>)</p>
                    <p><strong>ชื่อผู้รับบริการ :</strong> <%= b.customer_name %> (เบอร์โทร: <%= b.customer_phone %>)</p>
                    <p><strong>สถานะบริการ :</strong> 
                        <% if (b.status === 'completed') { %>
                            <span style="color: #28a745; font-weight: bold;">เสร็จสิ้น</span>
                        <% } else if (b.status === 'in-progress') { %>
                            <span style="color: #17a2b8; font-weight: bold;">กำลังดำเนินการ</span>
                        <% } else { %>
                            <span style="color: #ffc107; font-weight: bold;">รอดำเนินการ</span>
                        <% } %>
                    </p>
                </div>
            <% }); %>
        <% } else { %>
            <div class="empty-state">ยังไม่มีประวัติการเข้ารับบริการ</div>
        <% } %>
    </div>

    <script>
        function toggleHistoryDetail(index) {
            const detail = document.getElementById('history-detail-' + index);
            if (detail) {
                detail.style.display = detail.style.display === 'block' ? 'none' : 'block';
            }
        }
    </script>
</body>
</html>