<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>สถานะการดำเนินการ - Quick Fix</title>
    <link href="https://fonts.googleapis.com/css2?family=Prompt:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Prompt', sans-serif; background-color: #f2f7f2; margin: 0; padding: 0; color: #222; }
        
        .navbar { background-color: #2b2b2b; padding: 15px 40px; display: flex; justify-content: space-between; align-items: center; }
        .navbar .brand { font-size: 26px; font-weight: 700; color: #f4c430; text-decoration: none; }
        .navbar .nav-links a { color: #fff; text-decoration: none; margin-left: 20px; font-size: 15px; }
        .navbar .nav-links a.active { color: #f4c430; border-bottom: 2px solid #f4c430; padding-bottom: 4px; }

        .container { max-width: 900px; margin: 30px auto; background: #fff; padding: 35px; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); }
        .page-header { display: flex; align-items: center; gap: 10px; margin-bottom: 25px; }
        .btn-back { font-size: 20px; text-decoration: none; color: #222; border: 1px solid #ccc; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; }

        /* Box ข้อมูลลูกค้า & บริการ */
        .info-box { background-color: #fff3c4; padding: 18px 24px; border-radius: 10px; margin-bottom: 15px; }
        .info-box h4 { margin: 0 0 10px 0; font-size: 15px; color: #444; }
        .info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 10px; font-size: 14px; }
        .info-grid strong { color: #111; }

        /* Progress Stepper Bar Horizontal */
        .stepper-wrapper { display: flex; justify-content: space-between; align-items: center; margin: 40px 0 25px; position: relative; }
        .stepper-item { display: flex; flex-direction: column; align-items: center; position: relative; z-index: 2; flex: 1; }
        
        .step-counter { width: 50px; height: 50px; border-radius: 50%; background-color: #e0e0e0; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: bold; margin-bottom: 8px; transition: 0.3s; }
        .step-name { font-size: 14px; font-weight: 500; color: #666; text-align: center; }

        /* Line connecting steps */
        .stepper-item::after { position: absolute; content: ''; border-bottom: 6px solid #e0e0e0; width: 100%; top: 22px; left: 50%; z-index: 1; }
        .stepper-item:last-child::after { content: none; }

        /* Active / Completed Steps */
        .stepper-item.completed .step-counter { background-color: #4cd964; color: #fff; }
        .stepper-item.active .step-counter { background-color: #4cd964; color: #fff; box-shadow: 0 0 0 4px rgba(76, 217, 100, 0.2); }
        .stepper-item.completed::after { border-bottom-color: #4cd964; }

        /* Arrows styling like Figma */
        .stepper-line-arrow { position: absolute; top: 16px; left: 10%; right: 10%; z-index: 1; display: flex; justify-content: space-between; color: #4cd964; font-weight: bold; font-size: 16px; pointer-events: none; }

        .btn-detail-toggle { background-color: #ffcc00; color: #222; border: none; padding: 10px 35px; border-radius: 20px; font-family: 'Prompt'; font-weight: 600; font-size: 15px; cursor: pointer; display: block; margin: 25px auto 0; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
        
        /* Layout รายละเอียดแนวตั้ง (เมื่อเปิดดู) */
        .detail-vertical-wrapper { display: none; margin-top: 30px; border-top: 1px solid #eee; padding-top: 20px; }
        .vertical-step { display: flex; gap: 20px; position: relative; padding-bottom: 25px; }
        .vertical-step::before { content: ''; position: absolute; left: 22px; top: 45px; bottom: 0; width: 3px; background-color: #4cd964; }
        .vertical-step:last-child::before { display: none; }
        .vertical-icon { width: 45px; height: 45px; border-radius: 50%; background-color: #4cd964; color: white; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: bold; flex-shrink: 0; }
        .vertical-content { background: #fafafa; padding: 12px 18px; border-radius: 8px; flex-grow: 1; border-left: 3px solid #4cd964; }
        .vertical-content h5 { margin: 0 0 5px 0; font-size: 16px; color: #222; }
        .vertical-content p { margin: 2px 0; font-size: 13px; color: #555; }

        /* Empty State */
        .empty-state { text-align: center; padding: 60px 20px; }
        .empty-state h3 { font-size: 22px; color: #222; margin-bottom: 10px; }
        .empty-state p { color: #666; font-size: 14px; margin: 4px 0; }
    </style>
</head>
<body>

    <div class="navbar">
        <a href="/user" class="brand">Quick Fix</a>
        <div class="nav-links">
            <a href="/user">หน้าแรก</a>
            <a href="/user/status" class="active">สถานะ</a>
            <a href="/user/history">ประวัติ</a>
            <a href="/user/about">เกี่ยวกับ</a>
            <a href="/logout" style="color:#ff6b6b;">ออกจากระบบ</a>
        </div>
    </div>

    <div class="container">
        <div class="page-header">
            <a href="/user" class="btn-back">←</a>
            <h2 style="margin: 0; font-size: 22px;">สถานะการดำเนินการ</h2>
        </div>

        <% if (booking) { %>
            <% 
               const st = (booking.status || 'pending').toLowerCase();
               // คำนวณขั้นตอน (1 = รับรถ, 2 = ดำเนินการ, 3 = ตรวจสอบ, 4 = เสร็จสิ้น)
               let step = 1;
               if (st === 'in-progress') step = 2;
               if (st === 'completed') step = 4;
            %>

            <!-- ข้อมูลลูกค้า -->
            <div class="info-box">
                <h4>ข้อมูลลูกค้า :</h4>
                <div class="info-grid">
                    <div>ประเภท : <strong>รถยนต์</strong></div>
                    <div>ยี่ห้อ : <strong><%= booking.car_brand || '-' %></strong></div>
                    <div>รุ่นรถ : <strong><%= booking.car_model || '-' %></strong></div>
                    <div>ทะเบียน : <strong><%= booking.license_plate %></strong></div>
                    <div>จังหวัด : <strong><%= booking.province || '-' %></strong></div>
                </div>
                <div class="info-grid" style="margin-top: 8px;">
                    <div>ชื่อ : <strong><%= booking.customer_name || '-' %></strong></div>
                    <div>เบอร์ : <strong><%= booking.customer_phone || '-' %></strong></div>
                </div>
            </div>

            <!-- ข้อมูลบริการ -->
            <div class="info-box" style="background-color: #fff8d6;">
                <h4>ข้อมูลสำหรับการใช้บริการ :</h4>
                <div class="info-grid">
                    <div>วันที่ : <strong><%= booking.booking_date ? new Date(booking.booking_date).toLocaleDateString('th-TH') : '-' %></strong></div>
                    <div>บริการ : <strong><%= booking.service_program %></strong></div>
                    <div>ช่วงเวลา : <strong><%= booking.time_slot %> น.</strong></div>
                </div>
            </div>

            <!-- Stepper Horizontal (หลอดสีเขียว) -->
            <<%
    let currentStep = 1;
    if (booking.status === 'in-progress') currentStep = 2;
    if (booking.status === 'inspecting') currentStep = 3;
    if (booking.status === 'completed') currentStep = 4;
%>

<div class="stepper-container">
    <div class="stepper-line" style="width: <%= ((currentStep - 1) / 3) * 100 %>%;"></div>
    
    <div class="stepper-wrapper">
        <!-- Step 1 -->
        <div class="step-item <%= currentStep >= 1 ? 'active' : '' %>">
            <div class="step-circle"><%= currentStep > 1 ? '✓' : '1' %></div>
            <div class="step-label">รับรถ</div>
        </div>

        <!-- Step 2 -->
        <div class="step-item <%= currentStep >= 2 ? 'active' : '' %>">
            <div class="step-circle"><%= currentStep > 2 ? '✓' : '2' %></div>
            <div class="step-label">ดำเนินการ</div>
        </div>

        <!-- Step 3 -->
        <div class="step-item <%= currentStep >= 3 ? 'active' : '' %>">
            <div class="step-circle"><%= currentStep > 3 ? '✓' : '3' %></div>
            <div class="step-label">ตรวจสอบ</div>
        </div>

        <!-- Step 4 -->
        <div class="step-item <%= currentStep >= 4 ? 'active' : '' %>">
            <div class="step-circle"><%= currentStep >= 4 ? '✓' : '4' %></div>
            <div class="step-label">เสร็จสิ้น</div>
        </div>
    </div>
</div>

<style>
    /* โครงสร้าง Stepper พร้อมหลอดสีเขียว */
    .stepper-container {
        position: relative;
        margin: 40px 0 20px 0;
        padding: 0 20px;
    }
    .stepper-wrapper {
        display: flex;
        justify-content: space-between;
        position: relative;
        z-index: 2;
    }
    /* เส้นพื้นหลังสีเทา */
    .stepper-container::before {
        content: '';
        position: absolute;
        top: 20px;
        left: 40px;
        right: 40px;
        height: 6px;
        background-color: #e0e0e0;
        z-index: 1;
    }
    /* หลอดสถานะสีเขียวที่วิ่งตาม Step */
    .stepper-line {
        position: absolute;
        top: 20px;
        left: 40px;
        height: 6px;
        background-color: #28a745;
        z-index: 1;
        transition: width 0.4s ease;
    }
    .step-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        background: transparent;
    }
    .step-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background-color: #e0e0e0;
        color: #666;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 16px;
        transition: 0.3s;
    }
    .step-item.active .step-circle {
        background-color: #28a745;
        color: white;
        box-shadow: 0 0 10px rgba(40, 167, 69, 0.4);
    }
    .step-label {
        margin-top: 10px;
        font-size: 14px;
        font-weight: 500;
        color: #555;
    }
    .step-item.active .step-label {
        color: #28a745;
        font-weight: 600;
    }
</style>

            <button class="btn-detail-toggle" onclick="toggleDetails()">รายละเอียด</button>

            <!-- รายละเอียดแนวตั้ง ตาม Figma รูปขวา -->
            <div id="verticalDetails" class="detail-vertical-wrapper">
                <div class="vertical-step">
                    <div class="vertical-icon">✓</div>
                    <div class="vertical-content">
                        <h5>รับรถ</h5>
                        <p>บริษัทได้รับรถ : <%= booking.car_brand %> / <%= booking.car_model %></p>
                        <p>ทะเบียน : <%= booking.license_plate %> / <%= booking.province || 'ชลบุรี' %></p>
                        <p>จาก : <%= booking.customer_name %> / <%= booking.customer_phone %></p>
                        <p style="color:#28a745; font-weight:500;">เป็นที่เรียบร้อยแล้ว และกำลังดำเนินการในขั้นตอนถัดไป</p>
                    </div>
                </div>

                <div class="vertical-step">
                    <div class="vertical-icon" style="background-color: <%= step >= 2 ? '#4cd964' : '#ccc' %>;">
                        <%= step >= 2 ? '•••' : '' %>
                    </div>
                    <div class="vertical-content" style="<%= step < 2 ? 'border-left-color:#ccc;' : '' %>">
                        <h5>ดำเนินการ</h5>
                        <p>ขณะนี้กำลังดำเนินการ : <%= booking.service_program %></p>
                        <p>จะแล้วเสร็จภายในช่วงเวลา : <%= booking.time_slot %> น.</p>
                        <p>กรุณารอสักครู่</p>
                    </div>
                </div>
            </div>

        <% } else { %>
            <!-- กรณีไม่มีสถานะดำเนินการ อยู่ในรูปแบบ Figma รูปที่ 3 -->
            <div class="empty-state">
                <h3>ขณะนี้ยังไม่มีสถานะที่กำลังดำเนินการ</h3>
                <p>หากท่านได้ทำการเข้าใช้บริการแล้ว แต่สถานะไม่ขึ้น</p>
                <p>กรุณาติดต่อที่ฝ่ายบริการ Quick Fix หรือโทร 064-137-2757</p>
            </div>
        <% } %>
    </div>

    <script>
        function toggleDetails() {
            const detail = document.getElementById('verticalDetails');
            detail.style.display = detail.style.display === 'block' ? 'none' : 'block';
        }
    </script>
</body>
</html>